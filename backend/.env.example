FIREWORKS_API_KEY=your_fireworks_api_key_here
LLM_MODEL=accounts/fireworks/models/gpt-oss-120b
# This local prototype always uses isolated disk-persisted mock data.
MONGODB_URI=mongomock://localhost
MONGODB_DB=dasalon
TIMEZONE=Asia/Kolkata


# Voice channel (existing text LLM still uses FIREWORKS_API_KEY).
VOICE_ENABLED=true
# sarvam for live calls; fake only for deterministic tests.
STT_PROVIDER=sarvam
STT_MODEL=whisper-v3-turbo
# Historical official batch endpoint; verify account availability before demos.
FIREWORKS_AUDIO_URL=https://api.fireworks.ai/audio/v3-turbo
# Live calls require Sarvam; provider failures offer text, never switch speakers.
TTS_PROVIDER=sarvam
TTS_MODEL=bulbul:v4-flash
SARVAM_API_KEY=
# Exact trusted browser origins, comma-separated; include your HTTPS deployment.
VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required for remote voice settings/preview/usage; blank permits loopback only.
VOICE_ADMIN_TOKEN=
# Demo process limits; production requires shared distributed enforcement.
VOICE_MAX_UTTERANCE_SECONDS=30
VOICE_MAX_SESSION_SECONDS=900
VOICE_MAX_CONCURRENT_SESSIONS=10
VOICE_IDLE_TIMEOUT_SECONDS=60
VOICE_ENDPOINT_MS=700
VOICE_VAD_RMS=0.015
# Audio is never persisted by this implementation (including when true).
VOICE_STORE_AUDIO=false

# Live recognition auto-detects language, including code-mixed speech.
SARVAM_REALTIME_MODEL=saaras:v4
VOICE_LLM_MODEL=accounts/fireworks/models/gpt-oss-120b
PARTNER_API_BASE_URL=http://127.0.0.1:8001/mock-partner
